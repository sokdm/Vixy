# API
VITE_API_URL=/api
VITE_PUBLIC_APP_URL=https://your-domain.example
APP_ORIGIN=https://your-domain.example
VITE_UPDATE_MANIFEST_URL=https://your-domain.example/api/version
VIXY_RELEASES_URL=https://github.com/your-github-user/vixy/releases
VITE_WINDOWS_DOWNLOAD_URL=https://github.com/your-github-user/vixy/releases/latest/download/Vixy-Setup.exe

# Vixy database/auth
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/vixy
JWT_SECRET=replace_with_a_long_random_server_only_value
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace_with_a_strong_render_env_password
VITE_AUTH_SITE_URL=https://your-domain.example

# Morphly developer API - server-side only.
# Create a key with realtime:create scope and allow APP_ORIGIN in Morphly.
MORPHLY_API_KEY=morph_live_or_test_key_here

# Flutterwave - public key (safe to share, client-side only)
VITE_FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here

# Flutterwave - SECRET, server-side only
# Set these in Render dashboard -> Environment.
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your_flutterwave_webhook_secret_hash_here
# Server-only collection subaccount used for the 40% savings settlement share.
FLUTTERWAVE_SAVINGS_SUBACCOUNT_ID=your_flutterwave_savings_subaccount_id_here
# Set to "production" in production so test-mode credentials and payments are rejected.
FLUTTERWAVE_MODE=production

# Server-only random value used to hash referral validation rate-limit identifiers.
REFERRAL_RATE_LIMIT_SALT=replace_with_a_long_random_server_only_value

# Xmax AI - SECRET, server/Electron main-process only
# Set this in Render dashboard -> Environment.
XMAX_API_KEY=your_xmax_permanent_api_key_here
# Optional override. The global SDK and server default to this endpoint.
XMAX_API_BASE_URL=https://api.xmax.cloud/open/api/v1
# Optional per-session safety cap in seconds (default: 1800, maximum: 7200).
XMAX_MAX_SESSION_SECONDS=1800

# Vidu AI - SECRET, server-side only. Used for Vidu S2-Editing real-time streams.
VIDU_API_KEY=your_vidu_api_key_here
# Optional base URL override (default: https://api.vidu.com; domestic: https://api.vidu.cn).
VIDU_API_BASE_URL=https://api.vidu.com
# Optional per-session safety cap in seconds (default: 1800, maximum: 7200).
VIDU_MAX_SESSION_SECONDS=1800

# Customer communications - server-only. Never use VITE_ for these secrets.
RESEND_API_KEY=
# Must be an address on a domain verified in your Resend account.
RESEND_FROM_EMAIL=Your Brand <feedback@your-domain.example>
CRON_SECRET=
CUSTOMER_REMINDER_DAYS=14
# Origin hosting /api/email-preferences.
EMAIL_PUBLIC_BASE_URL=https://your-domain.example
